# These are loaded automatically from web/server/.env (never commit that file).
# Easiest: run `npm run setup:db` once. It asks for your MongoDB Atlas connection string, tests it, and writes .env.
PORT=5000
# MongoDB Atlas connection string (Atlas > Connect > Drivers > Node.js). It is the SHARED database, so every
# machine sees the same data. Required. Leave this empty in git and let `npm run setup:db` fill in .env.
MONGODB_URI=
# Python interpreter for the risk / BB84 engines (defaults to ../../.venv, then python/python3).
PYTHON_BIN=
# Session cookie: Secure (HTTPS only, __Host- prefix) when NODE_ENV=production. Set COOKIE_SECURE=false only for
# plain-HTTP testing of a production build.
# COOKIE_SECURE=true
# Failed sign-ins allowed per IP + email in 15 minutes before a lockout (default 8).
# AUTH_MAX_FAILURES=8
# Demo sign-in: a doorway account whose login creates a private sandbox copy of the sample data (deleted after
# 24 hours, at most 300 at once). Set DEMO_ACCOUNT=false to disable it, or change the credentials.
# DEMO_ACCOUNT=true
# DEMO_EMAIL=demo@quantvault.app
# DEMO_PASSWORD=DemoPass-2026!
# Python lanes: quick scoring (default 2 at a time) and QKD simulations / experiments (default 1 at a time).
# PYTHON_CONCURRENCY=2
# PYTHON_HEAVY_CONCURRENCY=1
# Offline work only: USE_LOCAL_DB=true starts a private throw-away local database (data is NOT shared).
# USE_LOCAL_DB=false
# Development only: DEV_DB_PERSIST=false starts the in-process MongoDB with a throw-away database.
# DEV_DB_PERSIST=true
