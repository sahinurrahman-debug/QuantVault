# Copy to .env (never commit it) and export these before `npm start`; none are required in development.
PORT=5000
# MongoDB connection string (Atlas or local). Required when NODE_ENV=production.
# If unset in development, an in-process MongoDB is started automatically.
MONGODB_URI=mongodb://127.0.0.1:27017/quantvault
# Python interpreter for the risk / BB84 engines (defaults to ../../.venv, then python/python3).
PYTHON_BIN=
# Skip computing the initial experiment batch on first start.
SKIP_EXPERIMENT_SEED=0
