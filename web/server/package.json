{
  "name": "quantvault-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QuantVault API: Express + MongoDB (Mongoose) in front of the Python risk and BB84 engines",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch-path=./src --watch-preserve-output src/index.js",
    "setup:db": "node scripts/setup-db.js",
    "test": "node --test --test-timeout=240000 test/api.test.js test/auth.test.js test/db.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mongoose": "^9.11.3"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
